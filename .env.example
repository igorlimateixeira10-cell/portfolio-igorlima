# Copie este arquivo pra `.env.local` (nunca commitado, ver .gitignore)
# e preencha com valores reais quando for fazer o deploy.

# URL final de produção do site (sem barra no fim), ex.: https://igorlima.dev
# Usada em app/[lang]/layout.tsx para: metadataBase, os links
# alternates/hreflang PT-EN, o Open Graph/Twitter card e o campo `url` do
# JSON-LD (schema.org/Person). Enquanto não estiver definida, o site
# inteiro funciona normalmente — só esses metadados de SEO/compartilhamento
# apontam pra http://localhost:3000 (o fallback já existente no código).
NEXT_PUBLIC_SITE_URL=
